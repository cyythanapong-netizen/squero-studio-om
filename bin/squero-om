#!/usr/bin/env bash
# Squero Studio OM: serves the built app (dist/) and the squero/0 server on one port.
set -e
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

binary="${SQUERO_OM_BIN:-}"
if [ -z "$binary" ]; then
  for b in "$here/server/build/squero-om" "$here/server/build/Release/squero-om" "$here/bin/squero-om.bin"; do
    if [ -x "$b" ]; then
      binary="$b"
      break
    fi
  done
  if [ -z "$binary" ] && command -v squero-om >/dev/null 2>&1; then
    binary="$(command -v squero-om)"
  fi
fi

if [ -z "$binary" ]; then
  echo "squero-om: native binary not found. Build it with: cmake -S server -B server/build && cmake --build server/build" >&2
  exit 1
fi

args=("$@")
case " ${args[*]} " in *" --app "*) ;; *) [ -f "$here/dist/index.html" ] && args+=(--app "$here/dist");; esac
exec "$binary" "${args[@]}"
