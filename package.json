{
  "name": "squero-studio-om",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "cmake -S server -B server/build -G Ninja && cmake --build server/build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:server": "server/build/squero_tests"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@paperboat/shared": "file:../paperboat-shared",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "description": "Squero Studio: OpenModelica. Acausal Modelica editor that exports Paperboat C++ backends.",
  "bin": {
    "squero-om": "bin/squero-om"
  }
}
